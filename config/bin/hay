#!/usr/bin/env bash

set -euo pipefail

source ~/.config/shell/_common.sh

_is_yes_no_question() {
	local _pane_id="$1"
	local _content _options _has_yes _has_no

	_content=$(herdr pane read --source visible "${_pane_id}" 2>/dev/null) || return 1

	# Require a numbered CLI picker menu (❯ N. marks the selected item)
	printf '%s' "${_content}" | grep -qE '^\s*❯\s+[0-9]+\.\s+\S' || return 1

	# Extract option labels: strip picker prefix and number prefix
	_options=$(printf '%s' "${_content}" |
		grep -E '^\s*(❯\s+|\s{2,})[0-9]+\.\s+[A-Za-z]' |
		sed 's/^\s*❯\s*//' |
		sed 's/^\s\{2,\}//' |
		sed 's/^[0-9]\+\.\s*//' |
		grep -vE '^$')

	_has_yes=$(printf '%s' "${_options}" | grep -ciE '^yes$' 2>/dev/null || true)
	_has_no=$(printf '%s' "${_options}" | grep -ciE '^no$' 2>/dev/null || true)

	[[ "${_has_yes}" -ge 1 ]] && [[ "${_has_no}" -ge 1 ]]
}

main() {
	local _name="hay"
	local _result _pane
	trap 'printf "\n"; info "${_name}" "stopped."; return 0' INT TERM

	info "${_name}" "watching for agents waiting for input (Ctrl+C to stop)..."

	while true; do
		_result=$(herdr agent list 2>/dev/null) || {
			sleep 2
			continue
		}

		while IFS= read -r _pane; do
			if _is_yes_no_question "${_pane}"; then
				herdr pane send-keys "${_pane}" Enter 2>/dev/null
			fi
		done < <(printf '%s' "${_result}" | jq -r '.result.agents[] | select(.agent_status | IN("idle", "running", "working") | not) | .pane_id')

		sleep 1
	done
}

main "$@"
